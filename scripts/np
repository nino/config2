#!/usr/bin/env bun

/**
 * np — Node dependency manager. Never wonder whether to use
 * `yarn`, `npm`, `pnpm`, `bun`, or `deno` again.
 *
 * Usage:
 *   np            --> `pnpm install`, `npm i`, `yarn`, `bun install`,
 *                     or `deno install`
 *   np add <pkg>  --> `pnpm add`, `npm install`, `yarn add`, `bun add`,
 *                     or `deno add`
 *   np <args>     --> `pnpm run <args>`, `npm run <args>`, `yarn <args>`,
 *                     `bun run <args>`, or `deno task <args>`
 *
 * The manager comes from whichever lockfile is present. Failing that, a
 * deno.json means Deno; with nothing at all, pnpm.
 *
 * If the current directory isn't a project, recurses one level into each
 * immediate subdirectory that is one.
 */

import { existsSync, readFileSync, readdirSync, statSync } from "node:fs";
import { dirname, join, relative } from "node:path";

const color =
  Boolean(process.stderr.isTTY) && !process.env.NO_COLOR && process.env.TERM !== "dumb";

const bold = (s: string) => (color ? `\x1b[1m${s}\x1b[22m` : s);
const red = (s: string) => (color ? `\x1b[31m${s}\x1b[39m` : s);
const dim = (s: string) => (color ? `\x1b[2m${s}\x1b[22m` : s);
const cyan = (s: string) => (color ? `\x1b[36m${s}\x1b[39m` : s);

/** Print a friendly error and stop. Blank strings become blank lines. */
function fail(message: string, ...details: string[]): never {
  console.error(`${red(bold("np:"))} ${message}`);
  if (details.length > 0) console.error("");
  for (const line of details) console.error(line === "" ? "" : `  ${line}`);
  process.exit(1);
}

/** Turn a caught value into something worth printing. */
function describe(err: unknown): string {
  if (err instanceof Error) {
    const code = (err as NodeJS.ErrnoException).code;
    return code ? `${err.message} (${code})` : err.message;
  }
  return String(err);
}

/** Paths inside the cwd read better relative; anything else stays absolute. */
function displayPath(path: string): string {
  const rel = relative(process.cwd(), path);
  return rel === "" || rel.startsWith("..") ? path : rel;
}

type Manager = "bun" | "deno" | "pnpm" | "npm" | "yarn";

/** Checked in this order, so the first lockfile found wins. */
const MANAGERS: Manager[] = ["bun", "deno", "pnpm", "npm", "yarn"];

/** Bun writes `bun.lock` now and `bun.lockb` in older versions. */
const LOCKFILES: Record<Manager, string[]> = {
  bun: ["bun.lock", "bun.lockb"],
  deno: ["deno.lock"],
  pnpm: ["pnpm-lock.yaml"],
  npm: ["package-lock.json"],
  yarn: ["yarn.lock"],
};

/** Deno keeps its tasks here, and a Deno project need not have a package.json. */
const DENO_CONFIGS = ["deno.json", "deno.jsonc"];

/** Anything that marks a directory as a project np can run in. */
const PROJECT_FILES = ["package.json", ...DENO_CONFIGS];

const INSTALL_HINTS: Record<Manager, string[]> = {
  bun: ["brew install oven-sh/bun/bun", "curl -fsSL https://bun.sh/install | bash"],
  deno: ["brew install deno", "curl -fsSL https://deno.land/install.sh | sh"],
  pnpm: ["brew install pnpm", "npm install --global pnpm"],
  npm: ["brew install node", "(npm ships with Node)"],
  yarn: ["brew install yarn", "npm install --global yarn"],
};

function isProject(dir: string): boolean {
  return PROJECT_FILES.some((file) => existsSync(join(dir, file)));
}

/**
 * Commands the package managers handle themselves, so `np <cmd>` shouldn't be
 * mistaken for a typo'd package.json script.
 */
const PASSTHROUGH = new Set([
  "add",
  "audit",
  "bin",
  "cache",
  "config",
  "create",
  "dedupe",
  "dlx",
  "exec",
  "why",
  "import",
  "info",
  "init",
  "install",
  "licenses",
  "link",
  "list",
  "ls",
  "node",
  "outdated",
  "pack",
  "patch",
  "plugin",
  "pm",
  "prune",
  "publish",
  "rebuild",
  "remove",
  "run",
  "set",
  "store",
  "unlink",
  "up",
  "upgrade",
  "version",
  "workspace",
  "workspaces",
  "x",
]);

const SIGNAL_EXIT_CODES: Record<string, number> = {
  SIGHUP: 129,
  SIGINT: 130,
  SIGQUIT: 131,
  SIGKILL: 137,
  SIGTERM: 143,
};

async function spawn(cmd: string[], cwd: string): Promise<number> {
  let proc;
  try {
    proc = Bun.spawn(cmd, {
      cwd,
      stdin: "inherit",
      stdout: "inherit",
      stderr: "inherit",
    });
  } catch (err) {
    const code = (err as NodeJS.ErrnoException).code;
    if (code === "ENOENT") {
      // `ensureInstalled` normally catches this first; PATH can change under us.
      fail(
        `Couldn't run \`${cmd[0]}\` — it's not in your $PATH.`,
        `Tried to run: ${cyan(cmd.join(" "))}`,
      );
    }
    if (code === "EACCES") {
      fail(
        `Not allowed to run \`${cmd[0]}\`.`,
        `Tried to run: ${cyan(cmd.join(" "))}`,
        "",
        `Check the permissions on ${Bun.which(cmd[0]) ?? cmd[0]}.`,
      );
    }
    fail(
      `Couldn't start \`${cmd.join(" ")}\`.`,
      describe(err),
    );
  }

  const status = await proc.exited;
  const signal = proc.signalCode;

  if (signal) {
    if (signal !== "SIGINT" && signal !== "SIGTERM") {
      console.error("");
      console.error(`${red(bold("np:"))} ${cmd[0]} was killed by ${signal}.`);
    }
    return SIGNAL_EXIT_CODES[signal] ?? 1;
  }

  return status ?? 0;
}

/**
 * Which manager does this directory want? Reports the file that decided it, or
 * null for np's default, since the difference matters when the manager turns
 * out to be missing.
 */
function detectManager(dir: string): { manager: Manager; source: string | null } {
  for (const manager of MANAGERS) {
    for (const lockfile of LOCKFILES[manager]) {
      if (existsSync(join(dir, lockfile))) return { manager, source: lockfile };
    }
  }
  // No lockfile, but a deno.json still says plainly which manager this is.
  for (const config of DENO_CONFIGS) {
    if (existsSync(join(dir, config))) return { manager: "deno", source: config };
  }
  return { manager: "pnpm", source: null };
}

/**
 * A binary that's on $PATH but not executable looks exactly like a missing one
 * to `Bun.which`, and it's a confusing enough trap to call out by name.
 */
function findUnexecutable(name: string): string | null {
  for (const entry of (process.env.PATH ?? "").split(":")) {
    if (entry === "") continue;
    const candidate = join(entry, name);
    try {
      if (statSync(candidate).isFile()) return candidate;
    } catch {
      // Not there, or not readable. Either way, keep looking.
    }
  }
  return null;
}

/** Bail with an actually helpful message if the chosen manager isn't installed. */
function ensureInstalled(manager: Manager, source: string | null, dir: string): void {
  if (Bun.which(manager)) return;

  const unexecutable = findUnexecutable(manager);
  if (unexecutable) {
    fail(
      `\`${manager}\` is at ${unexecutable}, but it isn't executable.`,
      `Fix it with:  ${cyan(`chmod +x ${unexecutable}`)}`,
      "",
      "Or reinstall it, if that file isn't meant to be there.",
    );
  }

  const alternatives = MANAGERS.filter((m) => m !== manager && Bun.which(m));
  const where = dir === process.cwd() ? "" : ` (in ${displayPath(dir)}/)`;
  const details: string[] = [];

  if (source) {
    details.push(`This project has a ${source}${where}, so np picked ${manager}.`);
  } else {
    details.push(
      `There's no lockfile${where ? ` in ${displayPath(dir)}/` : " here"}` +
        ` (${MANAGERS.flatMap((m) => LOCKFILES[m]).join(", ")}),`,
      `so np fell back to its default, ${manager}.`,
    );
  }

  details.push("");
  details.push(`Install it:  ${cyan(INSTALL_HINTS[manager][0])}`);
  details.push(dim(`             ${INSTALL_HINTS[manager][1]}`));

  if (alternatives.length > 0) {
    details.push("");
    details.push(
      `You do have ${alternatives.join(" and ")} installed. ` +
        (source
          ? `Using a different manager here would fight with ${source}.`
          : `Run \`${alternatives[0]} install\` once to create a lockfile and np will follow it.`),
    );
  } else {
    details.push("");
    details.push("No package manager at all was found on this machine.");
  }

  fail(`\`${manager}\` isn't installed, or isn't in your $PATH.`, ...details);
}

function readPackageJson(dir: string): Record<string, unknown> | null {
  const path = displayPath(join(dir, "package.json"));
  let raw: string;
  try {
    raw = readFileSync(join(dir, "package.json"), "utf8");
  } catch (err) {
    const code = (err as NodeJS.ErrnoException).code;
    if (code === "EACCES") {
      fail(`Can't read ${path} — permission denied.`);
    }
    if (code === "EISDIR") {
      fail(`${path} is a directory, not a file.`);
    }
    fail(`Can't read ${path}.`, describe(err));
  }

  try {
    const parsed = JSON.parse(raw);
    if (parsed === null || typeof parsed !== "object" || Array.isArray(parsed)) {
      fail(
        `${path} isn't a JSON object.`,
        "np (and every package manager) expects it to look like `{ \"name\": ... }`.",
      );
    }
    return parsed as Record<string, unknown>;
  } catch (err) {
    if (err instanceof SyntaxError) {
      fail(
        `${path} isn't valid JSON.`,
        err.message,
        "",
        "Fix it before running np — every package manager will choke on it too.",
      );
    }
    throw err;
  }
}

/**
 * Task names from a deno.json, with the file they came from. Deno tolerates
 * comments and trailing commas in both deno.json and deno.jsonc; Bun's
 * importer only tolerates them in .jsonc. Returning null when the file won't
 * parse means np skips its pre-flight check and lets deno report the problem
 * in its own words.
 */
async function readDenoTasks(dir: string): Promise<{ file: string; names: string[] } | null> {
  for (const file of DENO_CONFIGS) {
    const path = join(dir, file);
    if (!existsSync(path)) continue;
    try {
      const tasks = (await import(path)).default?.tasks;
      if (tasks === null || typeof tasks !== "object" || Array.isArray(tasks)) return null;
      return { file, names: Object.keys(tasks) };
    } catch {
      return null;
    }
  }
  return null;
}

/** Edit distance, for "did you mean" suggestions. */
function distance(a: string, b: string): number {
  const prev = Array.from({ length: b.length + 1 }, (_, i) => i);
  for (let i = 1; i <= a.length; i++) {
    let corner = prev[0];
    prev[0] = i;
    for (let j = 1; j <= b.length; j++) {
      const above = prev[j];
      prev[j] = Math.min(
        prev[j] + 1,
        prev[j - 1] + 1,
        corner + (a[i - 1] === b[j - 1] ? 0 : 1),
      );
      corner = above;
    }
  }
  return prev[b.length];
}

function suggest(name: string, candidates: string[]): string | null {
  let best: string | null = null;
  let bestDistance = Infinity;
  for (const candidate of candidates) {
    const d = distance(name.toLowerCase(), candidate.toLowerCase());
    if (d < bestDistance) {
      best = candidate;
      bestDistance = d;
    }
  }
  return best !== null && bestDistance <= Math.max(2, Math.floor(name.length / 3))
    ? best
    : null;
}

/**
 * Script names from a package.json. `strict` reports a malformed or missing
 * `scripts` section as an error; a Deno project keeps its tasks elsewhere, so
 * there it's merely nothing to add.
 */
function readPackageScripts(dir: string, name: string, strict: boolean): string[] | null {
  const scripts = readPackageJson(dir)?.scripts;
  const where = displayPath(join(dir, "package.json"));

  if (scripts === undefined || scripts === null) {
    if (strict) {
      fail(`There's no \`scripts\` section in ${where}, so there's no \`${name}\` to run.`);
    }
    return null;
  }
  if (typeof scripts !== "object" || Array.isArray(scripts)) {
    if (strict) fail(`The \`scripts\` field in ${where} isn't an object.`);
    return null;
  }
  return Object.keys(scripts as Record<string, unknown>);
}

/**
 * Catch `np biuld` before the package manager does, and say which scripts
 * actually exist.
 *
 * Deno runs the tasks in deno.json, plus the package.json scripts of a project
 * that also has one; every other manager reads package.json alone.
 */
async function checkScriptExists(dir: string, manager: Manager, args: string[]): Promise<void> {
  const name = args[0];
  if (name === undefined) return;
  if (name.startsWith("-")) return;
  if (PASSTHROUGH.has(name)) return;

  const names: string[] = [];
  const sources: string[] = [];

  if (manager === "deno") {
    const tasks = await readDenoTasks(dir);
    if (tasks) {
      names.push(...tasks.names);
      sources.push(tasks.file);
    }
  }

  if (manager !== "deno" || existsSync(join(dir, "package.json"))) {
    const scripts = readPackageScripts(dir, name, manager !== "deno");
    if (scripts) {
      names.push(...scripts);
      sources.push("package.json");
    }
  }

  if (names.includes(name)) return;
  // Nothing readable to check against. Say nothing, and let deno have its say.
  if (sources.length === 0) return;

  const noun = manager === "deno" ? "task" : "script";
  const where = sources.map((file) => displayPath(join(dir, file))).join(" or ");
  const details: string[] = [];

  const guess = suggest(name, names);
  if (guess) {
    details.push(`Did you mean ${cyan(`np ${guess}`)}?`);
    details.push("");
  }

  if (names.length === 0) {
    details.push(`${where} defines no ${noun}s.`);
  } else {
    details.push(`${noun[0].toUpperCase()}${noun.slice(1)}s in ${where}:`);
    for (const script of names.sort()) details.push(`  ${dim("·")} ${script}`);
  }

  fail(`No ${noun} called \`${name}\` in ${where}.`, ...details);
}

function buildCommand(manager: Manager, args: string[]): string[] {
  if (args.length === 0) {
    if (manager === "bun") return ["bun", "install"];
    if (manager === "deno") return ["deno", "install"];
    if (manager === "pnpm") return ["pnpm", "install"];
    if (manager === "npm") return ["npm", "i"];
    return ["yarn"];
  }

  if (args[0] === "add") {
    const rest = args.slice(1);
    if (rest.length === 0) {
      fail(
        "`np add` needs at least one package to add.",
        `For example: ${cyan("np add react")}`,
        "",
        `To install what's already in package.json, just run ${cyan("np")}.`,
      );
    }
    if (manager === "bun") return ["bun", "add", ...rest];
    if (manager === "deno") return ["deno", "add", ...rest];
    if (manager === "pnpm") return ["pnpm", "add", ...rest];
    if (manager === "npm") return ["npm", "install", ...rest];
    return ["yarn", "add", ...rest];
  }

  if (manager === "bun") return ["bun", "run", ...args];
  if (manager === "deno") return ["deno", "task", ...args];
  if (manager === "pnpm") return ["pnpm", "run", ...args];
  if (manager === "npm") return ["npm", "run", ...args];
  return ["yarn", ...args];
}

/** Run np in one directory: detect, sanity-check, spawn. */
async function run(dir: string, args: string[]): Promise<number> {
  const { manager, source } = detectManager(dir);
  ensureInstalled(manager, source, dir);
  await checkScriptExists(dir, manager, args);
  return spawn(buildCommand(manager, args), dir);
}

/** Nearest ancestor that is a project, so we can point somewhere useful. */
function findProjectAbove(dir: string): string | null {
  let current = dirname(dir);
  while (true) {
    if (isProject(current)) return current;
    const parent = dirname(current);
    if (parent === current) return null;
    current = parent;
  }
}

const argv = process.argv.slice(2);

let cwd: string;
try {
  cwd = process.cwd();
} catch (err) {
  fail(
    "Can't work out the current directory — it may have been deleted or renamed.",
    describe(err),
    "",
    `Try ${cyan("cd $PWD")} (or cd somewhere that exists) and run np again.`,
  );
}

if (!isProject(cwd)) {
  let entries: string[];
  try {
    entries = readdirSync(cwd);
  } catch (err) {
    const code = (err as NodeJS.ErrnoException).code;
    if (code === "EACCES") {
      fail(`Can't read ${cwd} — permission denied.`);
    }
    if (code === "ENOENT") {
      fail(`${cwd} doesn't exist any more.`);
    }
    fail(`Can't read ${cwd}.`, describe(err));
  }

  const projects = entries
    .filter((e) => {
      try {
        return statSync(join(cwd, e)).isDirectory();
      } catch {
        return false;
      }
    })
    .filter((e) => isProject(join(cwd, e)))
    .sort();

  if (projects.length === 0) {
    const above = findProjectAbove(cwd);
    const details = [
      `Looked in ${cwd} and one level down into its subdirectories.`,
    ];
    if (above) {
      details.push("");
      details.push(`There is one in ${cyan(above)} — did you mean to run np there?`);
    } else {
      details.push("");
      details.push(
        `If this is a new project, start it with ${cyan("npm init -y")}` +
          ` (or ${cyan("deno init")}, or yarn/pnpm/bun init).`,
      );
    }
    const wanted = `${PROJECT_FILES.slice(0, -1).join(", ")}, or ${PROJECT_FILES.at(-1)}`;
    fail(`No ${wanted} here.`, ...details);
  }

  for (const [index, dir] of projects.entries()) {
    console.log(`Running \`np\` in ${dir}`);
    const code = await run(join(cwd, dir), argv);
    if (code !== 0) {
      const remaining = projects.length - index - 1;
      console.error("");
      console.error(
        `${red(bold("np:"))} ${bold(dir)} exited with code ${code}. Stopping here` +
          (remaining > 0
            ? `; ${remaining} more ${remaining === 1 ? "directory" : "directories"} left untouched.`
            : "."),
      );
      process.exit(code);
    }
  }
  process.exit(0);
}

process.exit(await run(cwd, argv));
